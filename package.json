{
  "name": "taupytukas",
  "version": "1.0.0",
  "description": "Taupytukas — vaikų taupymo prototipas su tėvų misijomis, XP ir papildymais.",
  "private": true,
  "scripts": {
    "verify:web": "node --check script.js",
    "build:web": "node scripts/copy-web-assets.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "ios:sync": "npm run build:web && npx cap sync ios"
  },
